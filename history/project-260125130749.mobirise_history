          "_name": "features04",
          "_sourceTheme": "syncm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features04 syncm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showCardIcon\" checked>\n        <input type=\"color\" title=\"Icon BG\" value=\"#1b386e\" name=\"iconBg\" condition=\"showCardIcon\" selected>\n        <input type=\"color\" title=\"Gradient 1\" value=\"#ed83b2\" name=\"gradient_1\" condition=\"showCardIcon\" selected>\n        <input type=\"color\" title=\"Gradient 2\" value=\"#0175ff\" name=\"gradient_2\" condition=\"showCardIcon\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/syncm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/syncm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row items-wrapper justify-content-center\">\n              <h1 class=\"mbr-section-title mbr-fonts-style gradient-title mbr-white mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>עבודה טיפולית מבוססת תהליך</b></h1>\n                        <div class=\"col-12 col-lg-3 item features-without-image active\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                    <div class=\"icon-wrap card-wrap\">\n<span mbr-icon class=\"card-wrap card-icons mbr-iconfont mobi-mbri-briefcase\n mobi-mbri\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\">\n</span>\n\n                                    </div>\n                                </div>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn, .icon-wrapper\" mbr-if=\"showCardTitle\">מקצועיות בלי התפשרות</h4>\n                                <div class=\"text-wrap\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .text-wrap\">\n                                        העבודה מתבצעת מתוך הקפדה על רמת מקצועיות גבוהה, למידה מתמשכת והכנה מדויקת לכל מפגש. כל תהליך נבנה באופן אישי, תוך התאמה לצרכים הייחודיים של המטופל ולשלב ההתפתחותי שבו הוא נמצא</p>\n                                </div>\n                                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                        See More\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-3 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                    <div class=\"icon-wrap card-wrap\">\n<span mbr-icon class=\"card-wrap card-icons mbr-iconfont mobi-mbri-target mobi-mbri\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\">\n</span>\n\n                                    </div>\n                                </div>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn, .icon-wrapper\" mbr-if=\"showCardTitle\">תהליך ממוקד תוצאה</h4>\n                                <div class=\"text-wrap\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .text-wrap\">\n                                         זיהוי מדויק של הצורך הרגשי מאפשר בניית תהליך ממוקד, יעיל ובר־יישום. העבודה שואפת ליצירת שינוי מדיד במציאות היומיומית, ולא להישאר ברמת השיח בלבד</p>\n                                </div>\n                                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                        See More\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-3 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                    <div class=\"icon-wrap card-wrap\">\n<span mbr-icon class=\"card-wrap card-icons mbr-iconfont mobi-mbri-users mobi-mbri\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\">\n</span>\n\n                                    </div>\n                                </div>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn, .icon-wrapper\" mbr-if=\"showCardTitle\">יצירת חיבור ותשתית טיפולית</h4>\n                                <div class=\"text-wrap\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .text-wrap\">\n                                        יצירת סביבה בטוחה, מכילה ונטולת שיפוטיות מהווה בסיס לעבודה טיפולית משמעותית. החיבור נבנה מתוך הקשבה,<br>רגישות והבנה עמוקה של עולמו הרגשי של המטופל</p>\n                                </div>\n                                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                        See More\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
