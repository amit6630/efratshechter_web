\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#4479d9\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <h1 class=\"mbr-section-title mbr-fonts-style mbr-white mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>nlp מדיניות פרטיות אפרת שכטר</b></h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mbr-white mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubitle\">Header Subtitle</h2>\n                <p class=\"mbr-text mbr-white mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"> efratshechternlp.com ברוכים הבאים לאתר<br>מדיניות פרטיות זו נועדה להסביר כיצד אנו מתייחסים למידע הנמסר על ידי המשתמשים באתר<br>באמצעות שימוש באתר הנך מסכים למדיניות זו<br><br>איסוף מידע<br>במהלך השימוש באתר המשתמש עשוי למסור מידע אישי כגון שם, טלפון או כתובת דוא\"ל באמצעות טפסי יצירת קשר או הצ’אט בוט<br>המידע שנמסר אינו נשמר במאגר מידע ממוחשב אלא מועבר ישירות לכתובת הדוא\"ל של בעלת האתר<br>בנוסף האתר משתמש בכלים חיצוניים (כגון Google Analytics, Google Maps, קובצי Cookies וצ’אט בוט) שעשויים לאסוף נתונים טכניים כלליים על פעילות המשתמש באתר כמו כתובת IP, סוג דפדפן ונתוני שימוש סטטיסטיים<br><br>&nbsp;שימוש במידע<br>יצירת קשר עם המשתמש בהתאם לפרטים שמסר<br>מתן מענה לפניות דרך טפסי יצירת קשר או צ’אט בוט<br>ניתוח ושיפור חוויית השימוש באתר באמצעות כלים סטטיסטיים חיצוניים כגון Google Analytics<br>שליחת עדכונים ומידע רק אם המשתמש נתן לכך הסכמה<br><br>שיתוף מידע עם צדדים שלישיים<br>בעלת האתר אינה שומרת את המידע האישי ואינה מעבירה אותו לצדדים שלישיים<br>יחד עם זאת כלים חיצוניים כגון Google Analytics או Google Maps עשויים לאסוף מידע סטטיסטי על אופן השימוש באתר<br>מידע אישי יימסר רק אם החוק מחייב זאת<br><br>&nbsp;קישורים חיצוניים<br>האתר עשוי לכלול קישורים לאתרים חיצוניים כגון Google או רשתות חברתיות<br>אין לבעלת האתר שליטה על מדיניות הפרטיות של אתרים אלה והשימוש בהם הוא באחריות המשתמש בלבד<br><br>&nbsp;אבטחת מידע<br>המידע שנמסר בטפסים באתר נשלח ישירות לכתובת הדוא\"ל של בעלת האתר ואינו נשמר במאגר ממוחשב<br>ננקטים אמצעים סבירים כדי להגן על המידע במהלך ההעברה אך אין אפשרות להבטיח חסינות מוחלטת ברשת האינטרנט<br><br>&nbsp;זכויות המשתמש<br>כל משתמש רשאי<br>לבקש לדעת האם נשמר מידע אודותיו<br>לבקש את מחיקת המידע או תיקונו אם יש בכך צורך<br>לביצוע פנייה ניתן ליצור קשר עם בעלת האתר באמצעות דף צור קשר באתר<br><br>שינויים במדיניות הפרטיות<br>בעלת האתר רשאית לעדכן את מדיניות הפרטיות מעת לעת<br>המשך שימוש באתר לאחר השינוי מהווה הסכמה למדיניות המעודכנת<br><br>&nbsp;יצירת קשר<br>בכל שאלה או בקשה הנוגעת למדיניות פרטיות זו ניתן לפנות לבעלת האתר באמצעות המייל או הטלפון המופיעים בדף צור קשר<br></p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-danger\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Create Your Website!</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
