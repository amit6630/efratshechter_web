 && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/ryan-collins-ntm8e0ivqc0-unsplash.jpg-1256x1884.jpg\" alt>\n                    <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\"></p>\n                </div>\n            </div>\n            <div class=\"col-12\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>? שוב שיחת טלפון מבית ספר&nbsp;</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">הלב שלכם נשבר כשאתם שומעים שהילד שלכם לבד בהפסקה<br>&nbsp;, שהוא חוזר הביתה ואומר: לא היה לי עם מי לשחק ,לא שיתפו אותי<br>.. או שהוא כבר מיואש ולא רוצה ללכת לבית הספר<br><br>ואולי מהצד השני – אתם מקבלים כמעט כל יום טלפון מהמורה<br>כי הוא מתפרץ, רב עם כולם, חייב לומר את המילה האחרונה<br>.ואולי אפילו מתנהג באלימות<br><br>,לפעמים זה נראה שהוא לא מצליח להבין מה השתבש<br>ולפעמים הכאב מתפרץ בכעס, בבכי או בהתנהגות קשה<br>.ואתם עומדים שם חסרי אונים – רק רוצים לעזור לו למצוא את המקום שלו<br><br>כאמא( ל־5 ) וכמטפלת רגשית גם אני הייתי שם<br>ראיתי מקרוב כמה זה כואב כשהילד שלך<br>מתקשה ויום אחרי יום ,ואתם סובלים כי אין לכם&nbsp; את הכלים לעזור לו<br><br><b>&nbsp;סדנת מסע הקסם - נולדה בדיוק בשביל ילדים כאלה<br></b>כאלה שמנסים כל כך חזק, אבל פשוט צריכים מישהו שיראה אותם<br>ילמד אותם כלים רגשיים וחברתיים, ויעזור להם לפרוח באמת&nbsp;<br><br><b>כבר מאות ילדים</b> השתתפו במסע הקסם<br>רכשו כלים רגשיים וכישורים חברתיים<br><b><br></b><b>והיום הם פורחים– רגשית ,חברתית , ובעלי ביטחון עצמי</b><br><br><b><br></b><b>אל תחכו, הקשיים לא יעברו ללא טיפול מתאים&nbsp;</b><br><br><b><br></b><b>! הירשמו עכשיו</b><br>📞 להרשמה: 053-4401616<b><br></b><br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
