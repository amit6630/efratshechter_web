          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form2\" group=\"Form\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showmainsubTitle\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Colors</header>\n        <input type=\"color\" title=\"Icons\" name=\"iconColor\" value=\"#1c1c25\" selected>\n        <input type=\"color\" title=\"Icon 1 BG\" name=\"iconColor1\" value=\"#ed83b2\" selected>\n        <input type=\"color\" title=\"Icon 2 BG\" name=\"iconColor2\" value=\"#1a449a\" selected condition=\"cardsAmount > 1\">\n        <input type=\"color\" title=\"Icon 3 BG\" name=\"iconColor3\" value=\"#ed83b2\" selected condition=\"cardsAmount > 2\">\n        <input type=\"color\" title=\"Subtitle BG\" name=\"subtitle\" value=\"#1b386e\" selected condition=\"showmainsubTitle\">\n        <header>Style</header>\n        <input type=\"color\" name=\"btnColor\" title=\"Button BG\" value=\"#1b386e\">\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"checkbox\" name=\"disableElements\" title=\"Disable Control\">\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#1b386e\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#1b386e\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#1b386e\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#1b386e\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formFocusText\" title=\"Text Focus\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formFocusPlaceholder\" title=\"Placeholders Focus\" value=\"#ffffff\" condition=\"customStyle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay && bg.type=='image')\"></div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-lg-6 md-pb\">\n                <div class=\"card col-12\">\n                    <div class=\"card-wrapper\">\n                        <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                            <span class=\"icon-bg icon1\"></span>\n                            <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-map-pin mobi-mbri\"></span>\n                        </a>\n                        <div class=\"card-box my-auto\">\n                            <h3 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\"><b>מיקום</b></h3>\n\n                            <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\"><b>באר שבע</b></h5>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12\" mbr-if=\"cardsAmount > 1\">\n                    <div class=\"card-wrapper\">\n                        <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                            <span class=\"icon-bg icon2\"></span>\n                            <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                        </a>\n                        <div class=\"card-box my-auto\">\n                            <h3 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\"><b>אימייל</b></h3>\n                            <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\"><a href=\"mailto:efratshechternlp@gmail.com\" class=\"text-success\"><b>efratshechternlp@gmail.com</b></a></h5>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card col-12\" mbr-if=\"cardsAmount > 2\">\n                    <div class=\"card-wrapper\">\n                        <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                            <span class=\"icon-bg icon3\"></span>\n                            <span mbr-icon class=\"p-2 mbr-iconfont mobi-mbri-phone mobi-mbri\"></span>\n                        </a>\n                        <div class=\"card-box my-auto\">\n                            <h3 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\"><b>מספר טלפון</b></h3>\n                            <h5 class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\"><a href=\"tel:+972 534401616\" class=\"text-success\"><b>053-440-1616</b></a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div mbr-form class=\"col-lg-6 mx-auto mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"efratshechternlp@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" dir=\"rtl\" style=\"text-align:right;\">\n\n  <div class=\"row\">\n    <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">\n      הפרטיים הועברו בהצלחה\n    </div>\n    <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n      יש תקלה... נסה שוב\n    </div>\n  </div>\n\n  <div class=\"dragArea row\">\n\n    <div class=\"col-12\">\n      <h5 mbr-theme-style=\"display-4\" mbr-if=\"showmainsubTitle\" class=\"main-sub-title mbr-fonts-style mb-3\" style=\"text-align:right;\">\n        צור קשר\n      </h5>\n    </div>\n\n    <div class=\"col-12\">\n      <h4 mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" class=\"mbr-section-title mbr-fonts-style mb-3\">אפשר להתחיל בצעד קטן</h4>\n    </div>\n\n    <div class=\"col-12\">\n      <h5 mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" class=\"mbr-section-subtitle mbr-fonts-style mb-4\">השאירו פרטים לשיחה אישית<b> לגמרי בחינם</b>, ונבדוק יחד מה נכון לכם או לילדכם בשלב הזה.</h5>\n    </div>\n\n    <div data-for=\"name\" class=\"col-12 form-group mb-3\">\n      <label mbr-theme-style=\"display-7\" for=\"name\" class=\"form-control-label mbr-fonts-style\">\n        שם מלא\n      </label>\n      <input type=\"text\" name=\"name\" placeholder=\"שם מלא\" data-form-field=\"name\" mbr-theme-style=\"display-7\" class=\"form-control\" style=\"text-align:right;\">\n    </div>\n\n    <div data-for=\"phone\" class=\"col-12 form-group mb-3\">\n      <label mbr-theme-style=\"display-7\" for=\"phone\" class=\"form-control-label mbr-fonts-style\">\n        טלפון\n      </label>\n      <input type=\"tel\" name=\"phone\" placeholder=\"טלפון\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" class=\"form-control\" style=\"text-align:right;\">\n    </div>\n\n    <div data-for=\"select\" class=\"col-12 form-group mb-3\">\n      <label mbr-theme-style=\"display-7\" for=\"select\" class=\"form-control-label mbr-fonts-style\">\nסיבת הפנייה      </label>\n      <select name=\"select\" data-form-field=\"select\" mbr-theme-style=\"display-7\" class=\"form-control form-select\" style=\"text-align:right;\">\n        <option value=\"טיפול רגשי לילדים\">טיפול רגשי לילדים</option>\n        <option value=\"סדנאות\">סדנאות</option>\n        <option value=\"אחר\">אחר</option>\n      </select>\n    </div>\n\n    <div class=\"col-12 form-group mb-4\">\n      <div data-for=\"אני מסכים/מסכימה לתנאים ולהגבלות ולמדיניות הפרטיות ומאשר יצירת קשר מצד האתר\" class=\"form-check\">\n        <input type=\"checkbox\" value=\"Yes\" name=\"אני מסכים/מסכימה לתנאים ולהגבלות ולמדיניות הפרטיות ומאשר יצירת קשר מצד האתר\" data-form-field=\"אני מסכים/מסכימה לתנאים ולהגבלות ולמדיניות הפרטיות ומאשר יצירת קשר מצד האתר\" mbr-theme-style=\"display-7\" required class=\"form-check-input\" style=\"float:right; margin-left:8px;\">\n        <label mbr-theme-style=\"display-7\" class=\"form-check-label\" style=\"display:block;\">\n          אני מסכים/מסכימה לתנאים ולהגבלות ולמדיניות הפרטיות ומאשר יצירת קשר מצד האתר\n        </label>\n      </div>\n    </div>\n\n    <div class=\"col-12 mbr-section-btn\">\n      <a type=\"submit\" class=\"w-100 btn btn-success\" style=\"text-align:center;\">\n   שליחה\n      </a>\n    </div>\n\n  </div>\n</form>\n</div>\n        </div>\n    </div>\n</section>",
