          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features05 tradem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"color\" title=\"Card Title BG\" value=\"#ffffff\" name=\"titleBg\" condition=\"showCardTitle\" selected>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#ffffff\" name=\"border\" selected>\n        <input type=\"checkbox\" title=\"Card Transparent\" name=\"showTransparent\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/tradem5/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#1b386e\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/tradem5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#080813\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-mbr-fonts-style  gradient-title\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>כל מה שאתם צריכים • במקום אחד</b></h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrap\">\n            <div class=\"item features-without-image col-12 col-lg-4 active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>? NLP מה זה</b></h4>\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style rtl-text \" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">האנלפי הוא כלי טיפולי שמאפשר להבין איך מחשבות, רגשות ודפוסי התנהגות משפיעים על חיינו. באמצעות שיטות עדינות ומעשיות ניתן ליצור שינוי רגשי, לחזק ביטחון עצמי, \nלהתמודד עם פחדים וחסמים, ולפתח כלים להתמודדות טובה יותר עם אתגרי היום-יום<span class=\"rtl-dot\">.</span>\n\n                            </p>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-secondary\" href=\"nlp.html\" data-app-placeholder=\"Type Text\">\n                                    מידע נוסף\n                                </a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>טיפול רגשי פרטני</b></h4>\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style rtl-text\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">טיפול רגשי אישי המותאם לצרכים הייחודיים של כל ילד או מתבגר<br>התהליך מתקיים בסביבה בטוחה ותומכת, ומשלב כלים מעולם האנלפי הדמיון מודרך ויצירת קשר רגשי – במטרה לחזק ביטחון, לווסת רגשות <br>ולהתמודד עם קשיים רגשיים וחברתיים<span class=\"rtl-dot\">.</span>\n                                \n</p>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-secondary\" href=\"index.html#form02-7j\" data-app-placeholder=\"Type Text\">\n                                    מידע נוסף\n                                </a></div>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <b>סדנאות</b></h4>\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style rtl-text \" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">סדנאות קבוצתיות לילדים ולמתבגרים המעניקות כלים רגשיים וחברתיים דרך חוויה, שיח ותרגול מעשי הקבוצה מאפשרת תחושת שייכות, חיזוק כישורים חברתיים, פיתוח מודעות עצמית והתמודדות עם אתגרים בצורה בטוחה ומכילה<span class=\"rtl-dot\">.</span>\n\n                            </p>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-secondary\" href=\"workshops.html#header03-77\" data-app-placeholder=\"Type Text\">\n                                    מידע נוסף\n                                </a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n        </div>\n    </div>\n</section>",
