tle=\"Gradient Color 2\" value=\"#22a5e5\" name=\"gradient_2\" condition=\"showGradient\" selected>\n        <input type=\"color\" title=\"Gradient Color 3\" value=\"#ed83b2\" name=\"gradient_3\" condition=\"showGradient\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#080813\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b><span><b>?למה</b></span>&nbsp;לבחור בי</b></h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrap\">\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper card_1\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-contact-form mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .tags-wrapper, .icon-wrapper\" mbr-if=\"showCardTitle\"><b>איכות ומקצועיות</b></h4>\n                        <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"tag-wrapper\">ההתמקצעות, הניסיון והלמידה המתמשכת מבטיחים שירות מקצועי ואיכותי ללא פשרות. ההכנה למפגשים מותאמת באופן אישי ומוקפד לכל מטופל/ת</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper card_2\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-growing-chart mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .tags-wrapper, .icon-wrapper\" mbr-if=\"showCardTitle\"><b>שיפור ומגמת עלייה</b></h4>\n                        <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"tag-wrapper\">&nbsp;היכולת המהירה לזהות מהם צרכי המטופל ולהתאים עבורו את הטיפול המדויק לו, מקנה יתרון אדיר שגורם לשינוי מהיר במצב הרגשי והשגת המטרה</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-4\">\n                <div class=\"item-wrapper card_3\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <div class=\"icon-wrap\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\"></span>\n                            </div>\n                        </div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .tags-wrapper, .icon-wrapper\" mbr-if=\"showCardTitle\"><b>תקשורת וכימיה תוך שניות</b></h4>\n                        <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"tag-wrapper\">היכולת שלי להאזין בזהירות ובקשיבות אמיתית להבין את הרגשות והצרכים של המטופלים ללא  שיפוטיות , גורמת למטופל/ת המגיעים אליי להתחבר במהירות&nbsp;</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
